# =========================================================================
# REAL-TIME MULTIPLAYER CODING BATTLE PLATFORM - CENTRAL ENVIRONMENT TEMPLATE
# =========================================================================
# Copy this file to a local .env file inside each respective service folder
# or run with docker-compose which automatically injects these.
# =========================================================================

# -------------------------------------------------------------------------
# 1. CORE BACKEND (backend/) CONFIGURATIONS
# -------------------------------------------------------------------------
BACKEND_PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Databases
MONGO_URI=mongodb://localhost:27017/battlecode
REDIS_URL=redis://localhost:6379

# JWT Token Security (Use strong random strings in production!)
JWT_SECRET=your_ultra_secure_jwt_access_secret_key_change_me
JWT_REFRESH_SECRET=your_ultra_secure_jwt_refresh_secret_key_change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth 2.0 Social Login
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_key
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# SMTP Mail configurations (Email Verification & Password Recovery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_auth_user
SMTP_PASS=your_smtp_auth_password
FROM_EMAIL=no-reply@battlecode.com

# -------------------------------------------------------------------------
# 2. SOCKET SERVICE (socket-service/) CONFIGURATIONS
# -------------------------------------------------------------------------
SOCKET_PORT=6000
SOCKET_REDIS_URL=redis://localhost:6379
SOCKET_CORS_ORIGIN=http://localhost:5173

# -------------------------------------------------------------------------
# 3. COMPILER SERVICE (compiler-service/) CONFIGURATIONS
# -------------------------------------------------------------------------
COMPILER_REDIS_URL=redis://localhost:6379
COMPILER_SANDBOX_TIMEOUT_MS=2000
COMPILER_MAX_MEMORY_MB=256
COMPILER_MAX_CPU_CORES=1.0
COMPILER_DOCKER_IMAGE=battlecode-judge-sandbox:latest

# -------------------------------------------------------------------------
# 4. AI INTEL SERVICE (ai-service/) CONFIGURATIONS
# -------------------------------------------------------------------------
AI_PORT=8000
# Supported providers: gemini, openai
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
