# =========================================================================
# REAL-TIME MULTIPLAYER CODING BATTLE PLATFORM - ENVIRONMENT VARIABLES
# =========================================================================
# Copy this file to a local .env file in the root folder.
# Fill in your own credentials/keys. DO NOT commit the .env file to Git!
# =========================================================================

# ── General Server Configurations ─────────────────────────────────────────
BACKEND_PORT=5000
SOCKET_PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000

# ── Databases ────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/battlecode
REDIS_URL=redis://localhost:6379

# ── Upstash Redis (Optional for REST clients) ─────────────────────────────
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ── Brevo SMTP Mailer (Email Verification & Password Reset) ───────────────
BREVO_SENDER_EMAIL=your_sender_email@gmail.com
BREVO_API_KEY=your_brevo_api_key

# ── JWT Authentication (Use strong random hex keys in production) ────────
JWT_SECRET=your_jwt_access_secret_key
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRY=30d


# ── Judge0 Code Execution API (RapidAPI Gateway) ──────────────────────────
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_rapidapi_key

# ── LeetCode API Integration ───────────────────────────────────────────────
LEETCODE_API_URL=https://alfa-leetcode-api.onrender.com
PROBLEM_FETCH_TIMEOUT=5000


