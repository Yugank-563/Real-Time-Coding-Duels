{
  "name": "coduelo",
  "version": "1.0.0",
  "description": "Coduelo - Real-Time Coding Duels",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "socket-service",
    "compiler-service",
    "shared"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:socket": "npm run dev --workspace=socket-service",
    "dev:compiler": "npm run dev --workspace=compiler-service",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:socket\" \"npm run dev:compiler\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
